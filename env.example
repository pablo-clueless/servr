# --- server ---
TESTBED_PORT=8080
TESTBED_SCENARIO=scenarios/default.toml
RUST_LOG=info,testbed=debug

# --- data plane (compose.yaml) ---
# Host-side ports. Override any that collide with something already running
# locally — a native Postgres on 5432 shadows the container and produces
# "password authentication failed" against credentials that are correct.
# The dev container does not have this problem: nothing else is listening there.
# POSTGRES_PORT=55432
# REDIS_PORT=56379
# MAILPIT_HTTP_PORT=58025
POSTGRES_USER=testbed
POSTGRES_PASSWORD=testbed
POSTGRES_DB=testbed
DATABASE_URL=postgres://testbed:testbed@localhost:5432/testbed
# Queue storage. Unset means an in-memory queue that does not survive a restart.
REDIS_URL=redis://localhost:6379

# --- mail ---
# Mailpit owns SMTP and the read API. Isolation is the X-Testbed-Run header
# on send plus filtering on read (trap T7) — there is no per-run inbox.
MAILPIT_SMTP=localhost:1025
MAILPIT_HTTP=http://localhost:8025

# --- telemetry ---
# The app only ever speaks OTLP to a collector. What runs behind it is a
# compose concern: `docker compose --profile obs up -d`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=testbed
